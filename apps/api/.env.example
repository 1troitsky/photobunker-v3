APP_NAME="Example Application"
APP_SHORT_NAME="Example"
APP_SLUG="example-app"
APP_MARK="app"
APP_PUBLIC_URL="http://127.0.0.1:5173"
APP_ENV=local
APP_DEBUG=false
# Exact public browser origin, including port. Vite proxy sends requests to port 8000.
APP_URL=http://127.0.0.1:5173
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pb3
DB_USERNAME=pb3
DB_PASSWORD=
DB_SSLMODE=prefer
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
LOG_CHANNEL=stderr
QUEUE_CONNECTION=database
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=pb3-local
S3_ACCESS_KEY=
S3_SECRET_KEY=
# NEVER enable production data destruction until lifecycle acceptance.
PB3_ENABLE_PHOTO_CLEANUP=false
