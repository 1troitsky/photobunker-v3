{
  "name": "pb3/api",
  "description": "PB3 Laravel API foundation",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.4.27 <8.5 || >=8.5.12 <8.6",
    "laravel/framework": "^13.4",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ],
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
