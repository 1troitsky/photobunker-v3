{
  "name": "pb3-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pb3/web dev",
    "build": "pnpm --filter @pb3/web build",
    "typecheck": "pnpm --filter @pb3/web typecheck",
    "preview": "pnpm --filter @pb3/web preview",
    "test:web": "pnpm --filter @pb3/web test:unit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/mcp": "0.0.41",
    "@playwright/test": "1.56.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
