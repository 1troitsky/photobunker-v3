FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate
WORKDIR /srv/pb3
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web/ ./apps/web/
ARG VITE_APP_NAME
ARG VITE_APP_SHORT_NAME
ARG VITE_APP_SLUG
ARG VITE_APP_MARK
ARG VITE_APP_PUBLIC_URL
ARG VITE_APP_THEME_COLOR
ARG VITE_APP_ICON_URL
RUN pnpm build

FROM nginx:1.28-alpine
COPY local-runner/nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/pb3/apps/web/dist/ /usr/share/nginx/html/
EXPOSE 5173
